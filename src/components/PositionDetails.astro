---
import type { NavItem, Link, Fellowship } from './NavigationLayer.astro';

interface Props {
  item: NavItem;
}

const { item } = Astro.props;
---

<div class="position-details">
  {item.note && (
    <p class="position-note">{item.note}</p>
  )}
  
  {item.selected_media_coverage && item.selected_media_coverage.length > 0 && (
    <div class="detail-section">
      <h4 class="detail-label">Selected Media Coverage</h4>
      <div class="link-list">
        {item.selected_media_coverage.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-tag">
            {link.text}
          </a>
        ))}
      </div>
    </div>
  )}
  
  {item.selected_reviewing && item.selected_reviewing.length > 0 && (
    <div class="detail-section">
      <h4 class="detail-label">Selected Peer Review</h4>
      <div class="link-list">
        {item.selected_reviewing.map((r) => (
          <span class="link-tag">{r}</span>
        ))}
      </div>
    </div>
  )}
  
  {item.fellowships && item.fellowships.length > 0 && (
    <div class="detail-section">
      <h4 class="detail-label">Fellowships</h4>
      <div class="fellowship-list">
        {item.fellowships.map((f) => (
          <div class="fellowship-item">
            <span class="fellowship-title">{f.title}</span>
            <a href={f.url} target="_blank" rel="noopener noreferrer" class="link-tag">
              {f.organization}
            </a>
          </div>
        ))}
      </div>
    </div>
  )}
  
  {item.selected_articles && item.selected_articles.length > 0 && (
    <div class="detail-section">
      <h4 class="detail-label">Selected Articles</h4>
      <div class="link-list">
        {item.selected_articles.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-tag">
            {link.text}
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .position-details {
    width: 100%;
  }
  
  .position-note {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }
  
  .detail-section {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
  }
  
  .detail-section:first-of-type {
    border-top: none;
    padding-top: 0;
  }
  
  .detail-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }
  
  .fellowship-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  
  .fellowship-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  
  .fellowship-title {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }
</style>
