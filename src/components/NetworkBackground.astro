---
import type { NavItem } from './NavigationLayer.astro';

interface Props {
  sections: NavItem[];
}

const { sections } = Astro.props;

// Build a flat list of all nodes with their positions for the neural network
interface NodePosition {
  id: string;
  label: string;
  level: number;
  index: number;
  totalInLevel: number;
  parentId: string | null;
}

function flattenNodes(items: NavItem[], level: number = 0, parentId: string | null = null): NodePosition[] {
  const nodes: NodePosition[] = [];
  
  items.forEach((item, index) => {
    nodes.push({
      id: item.id,
      label: item.title,
      level,
      index,
      totalInLevel: items.length,
      parentId
    });
    
    if (item.children) {
      nodes.push(...flattenNodes(item.children, level + 1, item.id));
    }
  });
  
  return nodes;
}

const allNodes = flattenNodes(sections);

// Group by level
const levelMap = new Map<number, NodePosition[]>();
allNodes.forEach(node => {
  if (!levelMap.has(node.level)) {
    levelMap.set(node.level, []);
  }
  levelMap.get(node.level)!.push(node);
});

const maxLevel = Math.max(...levelMap.keys());

// Generate positions
const svgWidth = 1200;
const svgHeight = 2000;
const levelHeight = svgHeight / (maxLevel + 2);
const startY = levelHeight;

interface PositionedNode extends NodePosition {
  x: number;
  y: number;
}

const positionedNodes: PositionedNode[] = [];

levelMap.forEach((nodes, level) => {
  const y = startY + level * levelHeight;
  const spacing = svgWidth / (nodes.length + 1);
  
  nodes.forEach((node, i) => {
    positionedNodes.push({
      ...node,
      x: spacing * (i + 1),
      y
    });
  });
});

// Generate connections
interface Connection {
  fromId: string;
  toId: string;
  x1: number;
  y1: number;
  x2: number;
  y2: number;
}

const connections: Connection[] = [];

positionedNodes.forEach(node => {
  if (node.parentId) {
    const parent = positionedNodes.find(n => n.id === node.parentId);
    if (parent) {
      connections.push({
        fromId: parent.id,
        toId: node.id,
        x1: parent.x,
        y1: parent.y,
        x2: node.x,
        y2: node.y
      });
    }
  }
});

// Serialize data for client-side JavaScript
const networkData = JSON.stringify({ nodes: positionedNodes, connections });
---

<div class="network-background" id="network-background" data-network={networkData}>
  <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <!-- Gradient for connections -->
      <linearGradient id="connectionGradient" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" style="stop-color:#d0d0d0;stop-opacity:0.6" />
        <stop offset="100%" style="stop-color:#e8e8e8;stop-opacity:0.3" />
      </linearGradient>
      
      <!-- Glow filter for active nodes -->
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
    
    <!-- Connections (neural network style bezier curves) -->
    <g class="connections">
      {connections.map(conn => {
        const midY = (conn.y1 + conn.y2) / 2;
        const path = `M ${conn.x1} ${conn.y1} C ${conn.x1} ${midY}, ${conn.x2} ${midY}, ${conn.x2} ${conn.y2}`;
        return (
          <path 
            class="network-connection" 
            d={path}
            data-from={conn.fromId}
            data-to={conn.toId}
          />
        );
      })}
    </g>
    
    <!-- Nodes -->
    <g class="nodes">
      {positionedNodes.map(node => (
        <g class="node-group" data-id={node.id} data-level={node.level}>
          <circle 
            class="network-node" 
            cx={node.x} 
            cy={node.y} 
            r={node.level === 0 ? 12 : node.level === 1 ? 10 : 8}
            data-id={node.id}
          />
          <text 
            class="network-label"
            x={node.x}
            y={node.y + (node.level === 0 ? 28 : 24)}
            text-anchor="middle"
          >
            {node.label}
          </text>
        </g>
      ))}
    </g>
  </svg>
</div>

<style>
  .network-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s ease-out;
    overflow: hidden;
  }
  
  .network-background.visible {
    opacity: 1;
  }
  
  .network-background svg {
    width: 100%;
    height: 100%;
    min-height: 100vh;
  }
  
  .network-connection {
    stroke: var(--color-connection);
    stroke-width: 1.5;
    fill: none;
    opacity: 0.4;
    transition: stroke 0.3s ease, stroke-width 0.3s ease, opacity 0.3s ease;
  }
  
  .network-connection.active {
    stroke: var(--color-connection-active);
    stroke-width: 2.5;
    opacity: 0.8;
  }
  
  .network-node {
    fill: var(--color-node-inactive);
    transition: fill 0.3s ease, r 0.3s ease;
    opacity: 0.5;
  }
  
  .network-node.active {
    fill: var(--color-node-active);
    opacity: 1;
  }
  
  .network-node.path {
    fill: var(--color-node);
    opacity: 0.8;
  }
  
  .network-label {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--color-text-muted);
    opacity: 0.6;
    transition: opacity 0.3s ease, fill 0.3s ease;
    pointer-events: none;
  }
  
  .network-label.active {
    opacity: 1;
    fill: var(--color-text);
    font-weight: 600;
  }
  
  /* Parallax will be handled via JS transform */
</style>
