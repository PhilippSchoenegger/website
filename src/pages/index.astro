---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import PositionDetails from '../components/PositionDetails.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// Load content from YAML
const contentPath = path.join(process.cwd(), 'content.yaml');
const fileContents = fs.readFileSync(contentPath, 'utf8');
const content = yaml.load(fileContents) as any;

const { site, sections } = content;

// Serialize for client-side navigation
const sectionsJson = JSON.stringify(sections);

// Flatten all items for template generation
function flattenItems(items: any[], parentPath: string[] = []): any[] {
  const result: any[] = [];
  for (const item of items) {
    const currentPath = [...parentPath, item.id];
    result.push({ ...item, path: currentPath });
    if (item.children) {
      result.push(...flattenItems(item.children, currentPath));
    }
  }
  return result;
}

const allItems = flattenItems(sections);
---

<BaseLayout title="Philipp Schoenegger" description={site.intro}>
  <main class="main-container" id="main">
    
    <!-- Hero Section - Always visible at top -->
    <header class="hero" id="hero">
      <img 
        src="/pic.jpg" 
        alt="Philipp Schoenegger" 
        class="hero-photo" 
        width="140" 
        height="140"
        loading="eager"
        decoding="async"
      />
      <h1 class="hero-name">{site.title}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-intro">{site.intro}</p>
    </header>
    
    <!-- Navigation Tree Container - Horizontal levels -->
    <nav class="tree-container" id="tree-nav" aria-label="Content navigation">
      <!-- Level 0: Root categories (displayed horizontally) -->
      <div class="tree-level" data-level="0">
        {sections.map((section: any) => (
          <button 
            class="tree-node" 
            data-id={section.id}
            data-path={JSON.stringify([section.id])}
            data-has-children={section.children ? 'true' : 'false'}
            type="button"
            aria-pressed="false"
          >
            {section.title}
          </button>
        ))}
      </div>
      <!-- Additional levels will be inserted dynamically as horizontal rows -->
    </nav>
    
    <!-- Content Display Area -->
    <article id="content-display" class="content-display" aria-live="polite">
      <!-- Selected content renders here -->
    </article>
    
    <!-- Hidden templates for all content sections -->
    <div id="content-templates" hidden aria-hidden="true">
      {allItems.map((item: any) => (
        <template data-template-id={item.path.join('-')}>
          <div class="content-section" data-path={JSON.stringify(item.path)}>
            <header class="content-header">
              <h2 class="content-title">{item.title}</h2>
              {item.period && <p class="content-period">{item.period}</p>}
              {item.intro && <p class="content-intro">{item.intro}</p>}
            </header>
            
            {/* Position/Experience details */}
            {(item.links || item.funding || item.media_coverage || 
              item.fellowships || item.achievements || item.sponsors || item.articles ||
              item.projects || item.conferences || item.teaching || item.reviewing || item.note) && (
              <PositionDetails item={item} />
            )}
            
            {/* Publications */}
            {item.publications && item.publications.length > 0 && (
              <PublicationList publications={item.publications} />
            )}
          </div>
        </template>
      ))}
    </div>
  </main>
  
  <script define:vars={{ sectionsJson }}>
    window.__SECTIONS__ = JSON.parse(sectionsJson);
  </script>
  
  <script>
    // State management
    const state = {
      currentPath: [] as string[],
      expandedLevels: new Map<number, string>(), // level -> selected id
    };
    
    // DOM references
    const treeNav = document.getElementById('tree-nav')!;
    const contentDisplay = document.getElementById('content-display')!;
    
    // Smooth scroll utility - no jumping, gentle easing
    function smoothScrollTo(element: HTMLElement, offset = 0) {
      const targetPosition = element.getBoundingClientRect().top + window.scrollY - offset;
      const startPosition = window.scrollY;
      const distance = targetPosition - startPosition;
      const duration = Math.min(800, Math.max(400, Math.abs(distance) * 0.5)); // Adaptive duration
      let startTime: number | null = null;
      
      // Easing function - ease-out-quart for smooth deceleration
      function easeOutQuart(t: number): number {
        return 1 - Math.pow(1 - t, 4);
      }
      
      function animate(currentTime: number) {
        if (startTime === null) startTime = currentTime;
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easedProgress = easeOutQuart(progress);
        
        window.scrollTo(0, startPosition + distance * easedProgress);
        
        if (progress < 1) {
          requestAnimationFrame(animate);
        }
      }
      
      requestAnimationFrame(animate);
    }
    
    // Initialize
    document.addEventListener('DOMContentLoaded', init);
    
    function init() {
      // Attach click handlers via event delegation
      treeNav.addEventListener('click', handleNodeClick);
    }
    
    function handleNodeClick(e: Event) {
      const target = e.target as HTMLElement;
      const node = target.closest('.tree-node') as HTMLElement;
      if (!node) return;
      
      const pathStr = node.dataset.path;
      if (!pathStr) return;
      
      const path = JSON.parse(pathStr) as string[];
      selectPath(path);
    }
    
    function selectPath(path: string[]) {
      const level = path.length - 1;
      const nodeId = path[path.length - 1];
      
      // Update state
      state.currentPath = path;
      state.expandedLevels.set(level, nodeId);
      
      // Clear levels after this one
      for (let i = level + 1; i < 10; i++) {
        state.expandedLevels.delete(i);
      }
      
      // Update UI
      updateTreeUI(path);
      updateContent(path);
    }
    
    function updateTreeUI(selectedPath: string[]) {
      const sections = (window as any).__SECTIONS__;
      const level = selectedPath.length - 1;
      
      // Remove tree levels after the selected level with fade out
      const allLevels = treeNav.querySelectorAll('.tree-level');
      allLevels.forEach((levelEl) => {
        const levelNum = parseInt((levelEl as HTMLElement).dataset.level || '0');
        if (levelNum > level) {
          const el = levelEl as HTMLElement;
          el.style.opacity = '0';
          el.style.transform = 'translateY(-10px)';
          setTimeout(() => el.remove(), 200);
        }
      });
      
      // Update active states for existing nodes
      treeNav.querySelectorAll('.tree-node').forEach((node) => {
        const nodeEl = node as HTMLElement;
        const nodePath = JSON.parse(nodeEl.dataset.path || '[]') as string[];
        const nodeLevel = nodePath.length - 1;
        const nodeId = nodePath[nodePath.length - 1];
        
        // Check if this node is in the selected path
        const isSelected = state.expandedLevels.get(nodeLevel) === nodeId;
        nodeEl.classList.toggle('selected', isSelected);
        nodeEl.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });
      
      // Get the selected item to check for children
      const selectedItem = getItemByPath(sections, selectedPath);
      
      // If it has children, add a new tree level (horizontal row)
      if (selectedItem?.children?.length > 0) {
        const newLevel = document.createElement('div');
        newLevel.className = 'tree-level';
        newLevel.dataset.level = String(level + 1);
        newLevel.setAttribute('role', 'group');
        newLevel.setAttribute('aria-label', `${selectedItem.title} subcategories`);
        
        // Start with opacity 0 for fade-in
        newLevel.style.opacity = '0';
        newLevel.style.transform = 'translateY(-10px)';
        
        selectedItem.children.forEach((child: any) => {
          const button = document.createElement('button');
          button.className = 'tree-node';
          button.type = 'button';
          button.dataset.id = child.id;
          button.dataset.path = JSON.stringify([...selectedPath, child.id]);
          button.dataset.hasChildren = child.children ? 'true' : 'false';
          button.textContent = child.title;
          button.setAttribute('aria-pressed', 'false');
          newLevel.appendChild(button);
        });
        
        treeNav.appendChild(newLevel);
        
        // Animate in after append
        requestAnimationFrame(() => {
          newLevel.style.transition = 'opacity 0.3s ease-out, transform 0.3s ease-out';
          newLevel.style.opacity = '1';
          newLevel.style.transform = 'translateY(0)';
        });
      }
    }
    
    function updateContent(path: string[]) {
      const pathKey = path.join('-');
      const template = document.querySelector(`template[data-template-id="${pathKey}"]`) as HTMLTemplateElement;
      
      if (!template) {
        // Fade out existing content
        contentDisplay.style.opacity = '0';
        setTimeout(() => {
          contentDisplay.innerHTML = '';
          contentDisplay.style.opacity = '1';
        }, 200);
        return;
      }
      
      // Clone template content
      const content = template.content.cloneNode(true);
      
      // Fade out current content
      contentDisplay.style.transition = 'opacity 0.2s ease-out';
      contentDisplay.style.opacity = '0';
      
      // After fade out, update content and fade in
      setTimeout(() => {
        contentDisplay.innerHTML = '';
        contentDisplay.appendChild(content);
        
        // Fade in new content
        requestAnimationFrame(() => {
          contentDisplay.style.opacity = '1';
          
          // Smooth scroll to content with offset to keep nav visible
          const navHeight = treeNav.offsetHeight + 40;
          smoothScrollTo(contentDisplay, navHeight);
        });
      }, 200);
    }
    
    function getItemByPath(items: any[], path: string[]): any {
      if (path.length === 0) return null;
      const [first, ...rest] = path;
      const item = items.find((it: any) => it.id === first);
      if (!item) return null;
      if (rest.length === 0) return item;
      return getItemByPath(item.children || [], rest);
    }
  </script>
</BaseLayout>
