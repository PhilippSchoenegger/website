---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import PositionDetails from '../components/PositionDetails.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// Load content from YAML
const contentPath = path.join(process.cwd(), 'content.yaml');
const fileContents = fs.readFileSync(contentPath, 'utf8');
const content = yaml.load(fileContents) as any;

const { site, sections } = content;

// Serialize for client-side navigation
const sectionsJson = JSON.stringify(sections);

// Helper to get all items flattened with their paths
function flattenItems(items: any[], parentPath: string[] = [], level: number = 0): any[] {
  const result: any[] = [];
  for (const item of items) {
    const currentPath = [...parentPath, item.id];
    result.push({ ...item, path: currentPath, level });
    if (item.children) {
      result.push(...flattenItems(item.children, currentPath, level + 1));
    }
  }
  return result;
}

const allItems = flattenItems(sections);
---

<BaseLayout title="Philipp Schoenegger" description={site.intro}>
  <main class="main-container" id="main">
    
    <!-- Hero Section -->
    <section class="hero" id="hero">
      <img src="/pic.jpg" alt="Philipp Schoenegger" class="hero-photo" />
      <h1 class="hero-name">{site.title}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-intro">{site.intro}</p>
      
      <!-- Initial navigation buttons -->
      <nav class="nav-layer" id="nav-root" data-level="0">
        {sections.map((section: any) => (
          <button 
            class="nav-node" 
            data-id={section.id}
            data-path={JSON.stringify([section.id])}
          >
            <span class="node-indicator"></span>
            {section.title}
          </button>
        ))}
      </nav>
      
      <div class="scroll-indicator" id="scroll-hint">
        <span>Select to explore</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </section>
    
    <!-- Dynamic content area - sections render here as user navigates -->
    <div id="content-area">
      <!-- Content will be inserted dynamically -->
    </div>
    
    <!-- Hidden templates for all sections -->
    <div id="section-templates" style="display: none;">
      {allItems.map((item: any) => (
        <template data-template-id={item.path.join('-')}>
          <section class="section-block" data-section-path={JSON.stringify(item.path)}>
            <div class="section-header">
              <h2 class="section-title">{item.title}</h2>
              {item.period && <div class="section-period">{item.period}</div>}
              {item.intro && !item.period && <p class="section-intro">{item.intro}</p>}
            </div>
            
            {/* Position/Experience details */}
            {(item.links || item.funding || item.media_coverage || 
              item.fellowships || item.achievements || item.sponsors || item.articles ||
              item.projects || item.conferences || item.teaching || item.reviewing || item.note) && (
              <PositionDetails item={item} />
            )}
            
            {/* Publications */}
            {item.publications && item.publications.length > 0 && (
              <PublicationList publications={item.publications} />
            )}
            
            {/* Child navigation */}
            {item.children && item.children.length > 0 && (
              <Fragment>
                <div class="connection-line"></div>
                <nav class="nav-layer" data-parent-path={JSON.stringify(item.path)}>
                  {item.children.map((child: any) => (
                    <button 
                      class="nav-node" 
                      data-id={child.id}
                      data-path={JSON.stringify([...item.path, child.id])}
                    >
                      <span class="node-indicator"></span>
                      {child.title}
                    </button>
                  ))}
                </nav>
              </Fragment>
            )}
          </section>
        </template>
      ))}
    </div>
  </main>
  
  <script define:vars={{ sectionsJson }}>
    window.__SECTIONS__ = JSON.parse(sectionsJson);
  </script>
  
  <script>
    // State
    const visitedPaths: Set<string> = new Set();
    const currentPathStack: string[][] = [];
    
    // DOM
    const contentArea = document.getElementById('content-area')!;
    const scrollHint = document.getElementById('scroll-hint')!;
    const heroNav = document.getElementById('nav-root')!;
    
    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      setupNavigation();
    });
    
    function setupNavigation() {
      // Attach click handlers to all nav nodes (including dynamically added ones)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const navNode = target.closest('.nav-node') as HTMLElement;
        
        if (navNode) {
          const pathStr = navNode.dataset.path;
          if (pathStr) {
            const path = JSON.parse(pathStr);
            navigateToPath(path);
          }
        }
        
        // Handle path item clicks (breadcrumb navigation)
        const pathItem = target.closest('.path-item:not(.current)') as HTMLElement;
        if (pathItem) {
          const pathStr = pathItem.dataset.path;
          if (pathStr) {
            const path = JSON.parse(pathStr);
            navigateToPath(path, true);
          }
        }
      });
    }
    
    function navigateToPath(path: string[], isBackNav = false) {
      const pathKey = path.join('-');
      
      // Mark as visited
      visitedPaths.add(pathKey);
      
      // Hide scroll hint
      scrollHint.style.display = 'none';
      
      // Update hero nav buttons
      updateNavButtonStates(heroNav, path);
      
      // If going back, remove sections after the target
      if (isBackNav) {
        // Find which sections to remove
        const existingSections = contentArea.querySelectorAll('.section-block');
        let foundTarget = false;
        existingSections.forEach((section) => {
          const sectionPath = JSON.parse((section as HTMLElement).dataset.sectionPath || '[]');
          if (foundTarget) {
            section.remove();
          }
          if (JSON.stringify(sectionPath) === JSON.stringify(path)) {
            foundTarget = true;
          }
        });
        
        // Update path stack
        while (currentPathStack.length > 0) {
          const last = currentPathStack[currentPathStack.length - 1];
          if (JSON.stringify(last) === JSON.stringify(path)) {
            break;
          }
          currentPathStack.pop();
        }
        
        // Scroll to the target section
        const targetSection = contentArea.querySelector(`[data-section-path='${JSON.stringify(path)}']`);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        
        return;
      }
      
      // Add to path stack
      currentPathStack.push(path);
      
      // Get the template
      const template = document.querySelector(`template[data-template-id="${pathKey}"]`) as HTMLTemplateElement;
      if (!template) return;
      
      // Clone and insert
      const content = template.content.cloneNode(true) as DocumentFragment;
      
      // Add path indicator (breadcrumb)
      const section = content.querySelector('.section-block')!;
      const pathIndicator = createPathIndicator(path);
      section.insertBefore(pathIndicator, section.firstChild);
      
      // Append to content area
      contentArea.appendChild(content);
      
      // Update nav button states in the new section
      const newSection = contentArea.lastElementChild as HTMLElement;
      const navLayer = newSection.querySelector('.nav-layer');
      if (navLayer) {
        updateNavButtonStates(navLayer as HTMLElement, []);
      }
      
      // Scroll to the new section
      newSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      
      // Mark visited in all nav layers
      updateAllVisitedStates();
    }
    
    function createPathIndicator(path: string[]): HTMLElement {
      const container = document.createElement('div');
      container.className = 'path-indicator';
      
      const sections = (window as any).__SECTIONS__;
      let currentItems = sections;
      const pathSoFar: string[] = [];
      
      // Add "Home" first
      const homeItem = document.createElement('span');
      homeItem.className = 'path-item';
      homeItem.dataset.path = '[]';
      homeItem.textContent = 'Home';
      homeItem.addEventListener('click', () => {
        // Clear all content and reset
        contentArea.innerHTML = '';
        currentPathStack.length = 0;
        scrollHint.style.display = 'flex';
        updateNavButtonStates(heroNav, []);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      container.appendChild(homeItem);
      
      // Build path items
      for (let i = 0; i < path.length; i++) {
        const id = path[i];
        const item = currentItems.find((it: any) => it.id === id);
        if (!item) break;
        
        pathSoFar.push(id);
        
        // Separator
        const sep = document.createElement('span');
        sep.className = 'path-separator';
        sep.textContent = '→';
        container.appendChild(sep);
        
        // Path item
        const pathItem = document.createElement('span');
        pathItem.className = 'path-item' + (i === path.length - 1 ? ' current' : '');
        pathItem.dataset.path = JSON.stringify([...pathSoFar]);
        pathItem.textContent = item.title;
        container.appendChild(pathItem);
        
        currentItems = item.children || [];
      }
      
      return container;
    }
    
    function updateNavButtonStates(navLayer: HTMLElement, activePath: string[]) {
      const buttons = navLayer.querySelectorAll('.nav-node');
      buttons.forEach((btn) => {
        const el = btn as HTMLElement;
        const btnPath = JSON.parse(el.dataset.path || '[]');
        const btnId = btnPath[btnPath.length - 1];
        const activeId = activePath[activePath.length - 1];
        
        el.classList.toggle('active', btnId === activeId);
        el.classList.toggle('visited', visitedPaths.has(btnPath.join('-')) && btnId !== activeId);
      });
    }
    
    function updateAllVisitedStates() {
      document.querySelectorAll('.nav-node').forEach((btn) => {
        const el = btn as HTMLElement;
        const btnPath = JSON.parse(el.dataset.path || '[]');
        const isVisited = visitedPaths.has(btnPath.join('-'));
        const isActive = el.classList.contains('active');
        el.classList.toggle('visited', isVisited && !isActive);
      });
    }
  </script>
</BaseLayout>
