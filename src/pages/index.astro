---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import PositionDetails from '../components/PositionDetails.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// Load content from YAML
const contentPath = path.join(process.cwd(), 'content.yaml');
const fileContents = fs.readFileSync(contentPath, 'utf8');
const content = yaml.load(fileContents) as any;

const { site, sections } = content;

// Serialize for client-side navigation
const sectionsJson = JSON.stringify(sections);

// Flatten all items for template generation
function flattenItems(items: any[], parentPath: string[] = []): any[] {
  const result: any[] = [];
  for (const item of items) {
    const currentPath = [...parentPath, item.id];
    result.push({ ...item, path: currentPath });
    if (item.children) {
      result.push(...flattenItems(item.children, currentPath));
    }
  }
  return result;
}

const allItems = flattenItems(sections);
---

<BaseLayout title="Philipp Schoenegger" description={site.intro}>
  <!-- SVG definitions for tree connections -->
  <svg class="tree-svg-defs" aria-hidden="true">
    <defs>
      <linearGradient id="connection-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" style="stop-color:#bae6fd;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#0284c7;stop-opacity:1" />
      </linearGradient>
    </defs>
  </svg>

  <main class="tree-main" id="main">
    <!-- The Tree: A persistent, visual, navigable structure -->
    <div class="tree-canvas" id="tree-canvas">
      
      <!-- Root Node: The Person -->
      <div class="tree-root" id="tree-root">
        <div class="root-node" data-node-id="root">
          <img 
            src="/pic.jpg" 
            alt="Philipp Schoenegger" 
            class="root-photo"
            width="120" 
            height="120"
            loading="eager"
          />
          <h1 class="root-name">{site.title}</h1>
          <p class="root-tagline">{site.tagline}</p>
          <p class="root-intro">{site.intro}</p>
        </div>
        
        <!-- Connection lines will be drawn by SVG -->
        <svg class="tree-connections" id="tree-connections" aria-hidden="true"></svg>
        
        <!-- Level 0: Main branches -->
        <div class="tree-branches" id="tree-branches" data-level="0">
          {sections.map((section: any, index: number) => (
            <div class="branch-container" data-branch-id={section.id}>
              <button 
                class="tree-node level-0"
                data-node-id={section.id}
                data-path={JSON.stringify([section.id])}
                data-has-children={section.children ? 'true' : 'false'}
                data-index={index}
                type="button"
              >
                <span class="node-label">{section.title}</span>
                {section.children && <span class="node-expand-indicator">+</span>}
              </button>
              
              <!-- Child expansion area - will be populated dynamically -->
              <div class="branch-children" data-parent={section.id}></div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Content Panel: Slides in from the side or expands inline -->
      <aside class="content-panel" id="content-panel" aria-live="polite">
        <div class="panel-inner" id="panel-inner">
          <!-- Content will be inserted here -->
        </div>
      </aside>
    </div>
  </main>
  
  <!-- Hidden templates for all content sections -->
  <div id="content-templates" hidden aria-hidden="true">
    {allItems.map((item: any) => (
      <template data-template-id={item.path.join('-')}>
        <article class="content-article" data-path={JSON.stringify(item.path)}>
          <header class="article-header">
            <h2 class="article-title">{item.title}</h2>
            {item.period && <p class="article-period">{item.period}</p>}
            {item.intro && <p class="article-intro">{item.intro}</p>}
          </header>
          
          {(item.links || item.funding || item.media_coverage || 
            item.fellowships || item.achievements || item.sponsors || item.articles ||
            item.projects || item.conferences || item.teaching || item.reviewing || item.note) && (
            <PositionDetails item={item} />
          )}
          
          {item.publications && item.publications.length > 0 && (
            <PublicationList publications={item.publications} />
          )}
        </article>
      </template>
    ))}
  </div>
  
  <script define:vars={{ sectionsJson }}>
    window.__SECTIONS__ = JSON.parse(sectionsJson);
  </script>
  
  <script>
    // ============================================================================
    // GROUNDBREAKING TREE NAVIGATION
    // A true visual tree with persistent paths and smooth traversal
    // ============================================================================
    
    interface TreeState {
      expandedPaths: Map<string, string[]>; // nodeId -> full path
      activePath: string[];
      activeNodeId: string | null;
    }
    
    const state: TreeState = {
      expandedPaths: new Map(),
      activePath: [],
      activeNodeId: null,
    };
    
    // DOM Elements
    const treeCanvas = document.getElementById('tree-canvas')!;
    const treeBranches = document.getElementById('tree-branches')!;
    const treeConnections = document.getElementById('tree-connections')!;
    const contentPanel = document.getElementById('content-panel')!;
    const panelInner = document.getElementById('panel-inner')!;
    
    // ============================================================================
    // SMOOTH SCROLL ENGINE - Cinematic easing
    // ============================================================================
    
    function smoothScrollToElement(element: HTMLElement, options: {
      offset?: number;
      duration?: number;
      onComplete?: () => void;
    } = {}) {
      const { offset = 100, duration: customDuration, onComplete } = options;
      
      const rect = element.getBoundingClientRect();
      const absoluteY = rect.top + window.scrollY;
      const targetY = absoluteY - offset;
      const startY = window.scrollY;
      const distance = targetY - startY;
      
      // Adaptive duration based on distance
      const duration = customDuration ?? Math.min(1200, Math.max(500, Math.abs(distance) * 0.8));
      
      let startTime: number | null = null;
      
      // Cinematic ease-in-out-quint
      function easeInOutQuint(t: number): number {
        return t < 0.5 
          ? 16 * t * t * t * t * t 
          : 1 - Math.pow(-2 * t + 2, 5) / 2;
      }
      
      function animate(currentTime: number) {
        if (startTime === null) startTime = currentTime;
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easedProgress = easeInOutQuint(progress);
        
        window.scrollTo(0, startY + distance * easedProgress);
        
        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          onComplete?.();
        }
      }
      
      requestAnimationFrame(animate);
    }
    
    // ============================================================================
    // TREE STRUCTURE MANAGEMENT
    // ============================================================================
    
    function getItemByPath(path: string[]): any {
      let items = (window as any).__SECTIONS__;
      let current = null;
      
      for (const id of path) {
        current = items.find((item: any) => item.id === id);
        if (!current) return null;
        items = current.children || [];
      }
      
      return current;
    }
    
    function createNodeElement(item: any, path: string[], level: number): HTMLElement {
      const container = document.createElement('div');
      container.className = 'branch-container';
      container.dataset.branchId = item.id;
      container.dataset.level = String(level);
      
      const button = document.createElement('button');
      button.className = `tree-node level-${level}`;
      button.dataset.nodeId = item.id;
      button.dataset.path = JSON.stringify(path);
      button.dataset.hasChildren = item.children ? 'true' : 'false';
      button.type = 'button';
      
      const label = document.createElement('span');
      label.className = 'node-label';
      label.textContent = item.title;
      button.appendChild(label);
      
      if (item.children && item.children.length > 0) {
        const indicator = document.createElement('span');
        indicator.className = 'node-expand-indicator';
        indicator.textContent = '+';
        button.appendChild(indicator);
      }
      
      container.appendChild(button);
      
      // Child container
      const childrenContainer = document.createElement('div');
      childrenContainer.className = 'branch-children';
      childrenContainer.dataset.parent = item.id;
      container.appendChild(childrenContainer);
      
      return container;
    }
    
    function expandNode(nodeId: string, path: string[]) {
      const item = getItemByPath(path);
      if (!item) return;
      
      const nodeButton = document.querySelector(`[data-node-id="${nodeId}"]`) as HTMLElement;
      if (!nodeButton) return;
      
      // Mark as expanded
      nodeButton.classList.add('expanded');
      state.expandedPaths.set(nodeId, path);
      
      // Update indicator
      const indicator = nodeButton.querySelector('.node-expand-indicator');
      if (indicator) indicator.textContent = '−';
      
      // If has children, render them
      if (item.children && item.children.length > 0) {
        const container = nodeButton.closest('.branch-container');
        const childrenArea = container?.querySelector('.branch-children') as HTMLElement;
        
        if (childrenArea && childrenArea.children.length === 0) {
          // Create child nodes
          const childWrapper = document.createElement('div');
          childWrapper.className = 'children-wrapper';
          childWrapper.style.opacity = '0';
          childWrapper.style.transform = 'translateY(-20px)';
          
          item.children.forEach((child: any) => {
            const childPath = [...path, child.id];
            const childLevel = path.length;
            const childNode = createNodeElement(child, childPath, childLevel);
            childWrapper.appendChild(childNode);
          });
          
          childrenArea.appendChild(childWrapper);
          
          // Animate in
          requestAnimationFrame(() => {
            childWrapper.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out';
            childWrapper.style.opacity = '1';
            childWrapper.style.transform = 'translateY(0)';
          });
          
          // Update SVG connections
          requestAnimationFrame(() => {
            setTimeout(() => updateConnections(), 50);
          });
        }
      }
    }
    
    function collapseNode(nodeId: string) {
      const nodeButton = document.querySelector(`[data-node-id="${nodeId}"]`) as HTMLElement;
      if (!nodeButton) return;
      
      nodeButton.classList.remove('expanded');
      state.expandedPaths.delete(nodeId);
      
      // Update indicator
      const indicator = nodeButton.querySelector('.node-expand-indicator');
      if (indicator) indicator.textContent = '+';
      
      // Remove children with animation
      const container = nodeButton.closest('.branch-container');
      const childrenArea = container?.querySelector('.branch-children') as HTMLElement;
      
      if (childrenArea) {
        const wrapper = childrenArea.querySelector('.children-wrapper') as HTMLElement;
        if (wrapper) {
          wrapper.style.transition = 'opacity 0.3s ease-out, transform 0.3s ease-out';
          wrapper.style.opacity = '0';
          wrapper.style.transform = 'translateY(-20px)';
          
          setTimeout(() => {
            wrapper.remove();
            updateConnections();
          }, 300);
        }
        
        // Also collapse any expanded children
        const expandedChildren = childrenArea.querySelectorAll('.tree-node.expanded');
        expandedChildren.forEach((child) => {
          const childId = (child as HTMLElement).dataset.nodeId;
          if (childId) collapseNode(childId);
        });
      }
    }
    
    function selectNode(nodeId: string, path: string[]) {
      // Remove previous selection
      document.querySelectorAll('.tree-node.selected').forEach((el) => {
        el.classList.remove('selected');
      });
      
      // Add selection
      const nodeButton = document.querySelector(`[data-node-id="${nodeId}"]`) as HTMLElement;
      if (nodeButton) {
        nodeButton.classList.add('selected');
      }
      
      state.activePath = path;
      state.activeNodeId = nodeId;
      
      // Load content
      loadContent(path);
    }
    
    function loadContent(path: string[]) {
      const pathKey = path.join('-');
      const template = document.querySelector(`template[data-template-id="${pathKey}"]`) as HTMLTemplateElement;
      
      // Fade out current content
      panelInner.style.transition = 'opacity 0.3s ease-out';
      panelInner.style.opacity = '0';
      
      setTimeout(() => {
        if (template) {
          const content = template.content.cloneNode(true);
          panelInner.innerHTML = '';
          panelInner.appendChild(content);
          contentPanel.classList.add('active');
        } else {
          panelInner.innerHTML = '';
          contentPanel.classList.remove('active');
        }
        
        // Fade in
        requestAnimationFrame(() => {
          panelInner.style.opacity = '1';
        });
      }, 300);
    }
    
    // ============================================================================
    // SVG CONNECTION LINES - Visual tree structure
    // ============================================================================
    
    function updateConnections() {
      const svg = treeConnections;
      svg.innerHTML = '';
      
      // Get root node position
      const rootNode = document.querySelector('.root-node') as HTMLElement;
      if (!rootNode) return;
      
      const canvasRect = treeCanvas.getBoundingClientRect();
      
      // Draw connections for all expanded nodes
      document.querySelectorAll('.branch-container').forEach((container) => {
        const button = container.querySelector('.tree-node') as HTMLElement;
        const childrenWrapper = container.querySelector('.children-wrapper');
        
        if (!button || !childrenWrapper) return;
        
        const buttonRect = button.getBoundingClientRect();
        const parentX = buttonRect.left + buttonRect.width / 2 - canvasRect.left;
        const parentY = buttonRect.bottom - canvasRect.top;
        
        // Draw lines to each child
        childrenWrapper.querySelectorAll(':scope > .branch-container > .tree-node').forEach((child) => {
          const childRect = child.getBoundingClientRect();
          const childX = childRect.left + childRect.width / 2 - canvasRect.left;
          const childY = childRect.top - canvasRect.top;
          
          // Create curved path
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          const midY = (parentY + childY) / 2;
          
          const d = `M ${parentX} ${parentY} C ${parentX} ${midY}, ${childX} ${midY}, ${childX} ${childY}`;
          path.setAttribute('d', d);
          path.setAttribute('class', 'connection-line');
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', 'url(#connection-gradient)');
          path.setAttribute('stroke-width', '2');
          
          svg.appendChild(path);
        });
      });
    }
    
    // ============================================================================
    // EVENT HANDLING
    // ============================================================================
    
    function handleNodeClick(e: Event) {
      const target = e.target as HTMLElement;
      const nodeButton = target.closest('.tree-node') as HTMLElement;
      
      if (!nodeButton) return;
      
      const nodeId = nodeButton.dataset.nodeId;
      const pathStr = nodeButton.dataset.path;
      const hasChildren = nodeButton.dataset.hasChildren === 'true';
      
      if (!nodeId || !pathStr) return;
      
      const path = JSON.parse(pathStr) as string[];
      const isExpanded = nodeButton.classList.contains('expanded');
      const isSelected = nodeButton.classList.contains('selected');
      
      // First, scroll to the node smoothly
      smoothScrollToElement(nodeButton, {
        offset: 150,
        onComplete: () => {
          // Then handle the interaction
          if (hasChildren) {
            if (isExpanded && isSelected) {
              // Already expanded and selected - collapse
              collapseNode(nodeId);
            } else if (isExpanded) {
              // Expanded but not selected - just select
              selectNode(nodeId, path);
            } else {
              // Not expanded - expand and select
              expandNode(nodeId, path);
              selectNode(nodeId, path);
            }
          } else {
            // No children - just select
            selectNode(nodeId, path);
          }
        }
      });
    }
    
    // ============================================================================
    // INITIALIZATION
    // ============================================================================
    
    function init() {
      // Event delegation for node clicks
      treeCanvas.addEventListener('click', handleNodeClick);
      
      // Update connections on resize
      let resizeTimeout: number;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = window.setTimeout(updateConnections, 100);
      });
      
      // Initial connection draw
      updateConnections();
    }
    
    document.addEventListener('DOMContentLoaded', init);
  </script>
</BaseLayout>
