---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import PositionDetails from '../components/PositionDetails.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

// Load content from YAML
const contentPath = path.join(process.cwd(), 'content.yaml');
const fileContents = fs.readFileSync(contentPath, 'utf8');
const content = yaml.load(fileContents) as any;

const { site, sections } = content;

// Serialize for client-side navigation  
const sectionsJson = JSON.stringify(sections);

// Flatten all items for template generation
function flattenItems(items: any[], parentPath: string[] = []): any[] {
  const result: any[] = [];
  for (const item of items) {
    const currentPath = [...parentPath, item.id];
    result.push({ ...item, path: currentPath });
    if (item.children) {
      result.push(...flattenItems(item.children, currentPath));
    }
  }
  return result;
}

const allItems = flattenItems(sections);

// Collect featured publications across all sections
function collectFeatured(items: any[]): any[] {
  const result: any[] = [];
  for (const item of items) {
    if (item.publications) {
      for (const pub of item.publications) {
        if (pub.featured) result.push(pub);
      }
    }
    if (item.children) result.push(...collectFeatured(item.children));
  }
  return result;
}

const featuredPapers = collectFeatured(sections).sort((a, b) => b.year - a.year);

// Collect all publications across all sections for ScholarlyArticle JSON-LD
function collectAllPublications(items: any[]): any[] {
  const result: any[] = [];
  for (const item of items) {
    if (item.publications) result.push(...item.publications);
    if (item.children) result.push(...collectAllPublications(item.children));
  }
  return result;
}

const allPublications = collectAllPublications(sections);

// Build ScholarlyArticle JSON-LD entries for each publication
const scholarlyArticles = allPublications.map((pub: any) => {
  const authors = [{ "@type": "Person", "name": "Philipp Schoenegger" }];
  if (pub.coauthors) {
    const coauthorList = pub.coauthors
      .split(/,\s*(?![^()]*\))/)
      .map((name: string) => name.trim())
      .filter((name: string) => name.length > 0 && !name.startsWith("..."));
    for (const name of coauthorList) {
      authors.push({ "@type": "Person", "name": name });
    }
  }
  const article: any = {
    "@context": "https://schema.org",
    "@type": "ScholarlyArticle",
    "name": pub.title,
    "headline": pub.title,
    "datePublished": String(pub.year),
    "author": authors,
  };
  if (pub.url) article.url = pub.url;
  if (pub.journal) {
    article.isPartOf = {
      "@type": "Periodical",
      "name": pub.journal.replace(/\s*\(.*?\)$/, ""),
    };
  }
  if (pub.abstract) article.abstract = pub.abstract;
  return article;
});

// Create a map of path -> title for breadcrumb lookups
const pathToTitle = new Map<string, string>();
for (const item of allItems) {
  pathToTitle.set(item.path.join('/'), item.title);
}

// Create a map of path -> siblings info for navigation
// Returns { siblings: [{id, title}], currentIndex: number }
function getSiblingsInfo(path: string[]): { siblings: {id: string, title: string}[], currentIndex: number } {
  if (path.length === 0) return { siblings: [], currentIndex: -1 };
  
  // Find parent's children
  let parentChildren = sections;
  for (let i = 0; i < path.length - 1; i++) {
    const parent = parentChildren.find((item: any) => item.id === path[i]);
    if (!parent || !parent.children) return { siblings: [], currentIndex: -1 };
    parentChildren = parent.children;
  }
  
  const currentId = path[path.length - 1];
  const siblings = parentChildren.map((item: any) => ({ id: item.id, title: item.title }));
  const currentIndex = siblings.findIndex(s => s.id === currentId);
  
  return { siblings, currentIndex };
}

// Store siblings info for each item
const itemSiblingsMap = new Map<string, { siblings: {id: string, title: string}[], currentIndex: number }>();
for (const item of allItems) {
  itemSiblingsMap.set(item.path.join('/'), getSiblingsInfo(item.path));
}

// Parse intro/tagline markdown to HTML (with paragraph support)
const addLinkTargets = (html: string) =>
  html.replace(/<a\s+/g, '<a target="_blank" rel="noopener noreferrer" ');

const introHtml = addLinkTargets(marked.parse(site.intro.trim()));
const taglineHtml = addLinkTargets(marked.parse(site.tagline.trim()));

const homepageDescription = "Philipp Schoenegger — Futures Researcher at Microsoft AI's Futures team within Microsoft Superintelligence. Research on AI evaluations, frontier safety, AI usage analysis, forecasting, and behavioural science.";
---

<BaseLayout title="Philipp Schoenegger — Futures Researcher, Microsoft AI" description={homepageDescription} scholarlyArticles={scholarlyArticles}>
  <div class="journey-wrapper" id="journey-wrapper">
    
    <!-- Hero: The starting point -->
    <header class="hero-chapter" id="hero">
      <div class="hero-content">
        <img 
          src="/pic.jpg" 
          alt="Philipp Schoenegger" 
          class="hero-photo"
          width="140" 
          height="140"
          loading="eager"
        />
        <h1 class="hero-name">{site.title}</h1>
        <p class="hero-tagline" set:html={taglineHtml}></p>
        <div class="hero-intro" set:html={introHtml}></div>
      </div>

      {featuredPapers.length > 0 && (
        <section class="featured-papers" aria-labelledby="featured-papers-heading">
          <h2 class="featured-papers-heading" id="featured-papers-heading">Recent Work at Microsoft AI</h2>
          <div class="featured-papers-grid">
            {featuredPapers.map((pub: any) => (
              <article class="featured-paper-card">
                <div class="featured-paper-year">{pub.year}</div>
                <h3 class="featured-paper-title">
                  {pub.url ? (
                    <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                  ) : (
                    pub.title
                  )}
                </h3>
                {pub.journal && <div class="featured-paper-journal">{pub.journal}</div>}
                {pub.coauthors && <div class="featured-paper-coauthors">with {pub.coauthors}</div>}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Root navigation - always visible -->
      <nav class="chapter-nav" aria-label="Main sections">
        <div class="nav-buttons">
          {sections.map((section: any) => (
            <button 
              class="nav-btn"
              data-path={JSON.stringify([section.id])}
              data-id={section.id}
              type="button"
            >
              {section.title}
            </button>
          ))}
        </div>
      </nav>
    </header>
    
    <!-- Journey Container: Content chapters append here -->
    <main class="journey-container" id="journey-container" aria-live="polite">
      <!-- Chapters will be dynamically inserted -->
    </main>
    
    <!-- Back to top button -->
    <div class="back-to-top-container" id="back-to-top" hidden>
      <button class="back-to-top-btn" data-scroll-to="hero" type="button" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
      </button>
    </div>

    <!-- Footer -->
    <footer class="site-footer" id="site-footer" hidden>
      <div class="footer-content">
        <span class="footer-name">Philipp Schoenegger</span>
        <div class="footer-links">
          <a href="https://x.com/SchoeneggerPhil" target="_blank" rel="noopener noreferrer">Twitter</a>
          <a href="https://www.linkedin.com/in/philipp-schoenegger-755117211/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://scholar.google.com/citations?hl=en&user=kDAq8DcAAAAJ&view_op=list_works&sortby=pubdate" target="_blank" rel="noopener noreferrer">Google Scholar</a>
          <a id="contact-email" href="#" aria-label="Email Philipp Schoenegger">Email</a>
        </div>
      </div>
    </footer>
  </div>
  
  <!-- Hidden templates for all content sections -->
  <div id="content-templates" hidden aria-hidden="true">
    {allItems.map((item: any) => (
      <template data-template-id={item.path.join('/')}>
        <article 
          class="content-chapter" 
          data-chapter-path={JSON.stringify(item.path)}
          data-chapter-id={item.id}
          data-chapter-depth={item.path.length}
        >
          <!-- Breadcrumb trail with sibling stacks -->
          <nav class="chapter-breadcrumb" aria-label="Breadcrumb">
            <button class="breadcrumb-home" data-scroll-to="hero" type="button">
              Home
            </button>
            {item.path.map((id: string, idx: number) => {
              const currentPath = item.path.slice(0, idx + 1);
              const pathKey = currentPath.join('/');
              const siblingsInfo = itemSiblingsMap.get(pathKey) || { siblings: [], currentIndex: -1 };
              const isLast = idx === item.path.length - 1;
              const parentPath = currentPath.slice(0, -1);
              const siblingsAbove = siblingsInfo.siblings.slice(0, siblingsInfo.currentIndex);
              const siblingsBelow = siblingsInfo.siblings.slice(siblingsInfo.currentIndex + 1);
              
              return (
                <div class="sibling-stack">
                  {/* Siblings above current */}
                  {siblingsAbove.length > 0 && (
                    <div class="siblings-above">
                      {siblingsAbove.map((sib) => {
                        const sibPath = [...parentPath, sib.id];
                        return (
                          <button 
                            class="sibling-option"
                            data-nav-to={JSON.stringify(sibPath)}
                            type="button"
                          >
                            {sib.title}
                          </button>
                        );
                      })}
                    </div>
                  )}
                  {/* Selected row with arrow */}
                  <div class="selected-row">
                    <span class="breadcrumb-sep">→</span>
                    {isLast ? (
                      <span class="breadcrumb-current sibling-selected">{item.title}</span>
                    ) : (
                      <button 
                        class="breadcrumb-item sibling-selected" 
                        data-scroll-to={pathKey}
                        type="button"
                      >
                        {pathToTitle.get(pathKey) || id}
                      </button>
                    )}
                  </div>
                  {/* Siblings below current */}
                  {siblingsBelow.length > 0 && (
                    <div class="siblings-below">
                      {siblingsBelow.map((sib) => {
                        const sibPath = [...parentPath, sib.id];
                        return (
                          <button 
                            class="sibling-option"
                            data-nav-to={JSON.stringify(sibPath)}
                            type="button"
                          >
                            {sib.title}
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>
              );
            })}
          </nav>
          
          <!-- Chapter content -->
          <div class="chapter-body">
            <header class="chapter-header">
              <h2 class="chapter-title">{item.title}</h2>
              {item.period && <p class="chapter-period">{item.period}</p>}
              {item.intro && (
                <p
                  class="chapter-intro"
                  set:html={item.intro
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
                    .replace(/\n\s*\n/g, '<br><br>')}
                />
              )}
            </header>
            
            <!-- Position/Experience details -->
            {(item.selected_media_coverage || item.selected_reviewing || 
              item.fellowships || item.selected_articles || item.note) && (
              <PositionDetails item={item} />
            )}
            
            <!-- Publications -->
            {item.publications && item.publications.length > 0 && (
              <PublicationList publications={item.publications} />
            )}
          </div>
          
          <!-- Child navigation -->
          {item.children && item.children.length > 0 && (
            <nav class="chapter-nav" aria-label={`${item.title} subsections`}>
              <div class="nav-buttons">
                {item.children.map((child: any) => (
                  <button 
                    class="nav-btn"
                    data-path={JSON.stringify([...item.path, child.id])}
                    data-id={child.id}
                    type="button"
                  >
                    {child.title}
                  </button>
                ))}
              </div>
            </nav>
          )}
          
          <!-- End of chapter marker for collapse detection -->
          <div class="chapter-end" data-chapter-end={item.path.join('/')}></div>
        </article>
      </template>
    ))}
  </div>
  
  <script define:vars={{ sectionsJson }}>
    window.__SECTIONS__ = JSON.parse(sectionsJson);
  </script>
  
  <script>
    // ============================================================================
    // IMMERSIVE CONTENT JOURNEY
    // A scrolling document that builds as you explore
    // ============================================================================
    
    interface JourneyState {
      activePath: string[];
      chapters: Map<string, HTMLElement>; // path string -> element
    }
    
    const state: JourneyState = {
      activePath: [],
      chapters: new Map(),
    };
    
    // DOM Elements
    const journeyContainer = document.getElementById('journey-container')!;
    const heroSection = document.getElementById('hero')!;
    
    // Track scroll position for auto-collapse
    let ticking = false;
    let isNavigating = false; // Prevent collapse during programmatic scroll
    
    // ============================================================================
    // CINEMATIC SCROLL ENGINE
    // ============================================================================
    
    function smoothScrollTo(targetY: number, options: {
      duration?: number;
      onComplete?: () => void;
    } = {}): void {
      const startY = window.scrollY;
      const distance = targetY - startY;
      
      // Adaptive duration: a bit longer for a softer feel
      const baseDuration = options.duration ?? Math.min(1800, Math.max(700, Math.abs(distance) * 0.8));
      
      let startTime: number | null = null;
      
      // Softer ease-in-out cubic for gentler motion
      function easeInOutCubic(t: number): number {
        return t < 0.5
          ? 4 * t * t * t
          : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }
      
      isNavigating = true;
      
      function animate(currentTime: number) {
        if (startTime === null) startTime = currentTime;
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / baseDuration, 1);
        const easedProgress = easeInOutCubic(progress);
        
        window.scrollTo(0, startY + distance * easedProgress);
        
        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          isNavigating = false;
          options.onComplete?.();
        }
      }
      
      requestAnimationFrame(animate);
    }
    
    function scrollToElement(element: HTMLElement, offset = 20): void {
      const rect = element.getBoundingClientRect();
      const targetY = rect.top + window.scrollY - offset;
      smoothScrollTo(targetY);
    }
    
    // ============================================================================
    // CHAPTER MANAGEMENT
    // ============================================================================
    
    function getPathKey(path: string[]): string {
      return path.join('/');
    }
    
    function getChapterElement(path: string[]): HTMLElement | null {
      return state.chapters.get(getPathKey(path)) || null;
    }
    
    // Get the sections data for sibling index lookups
    const sectionsData = (window as any).__SECTIONS__ as any[];
    
    function findItemChildren(path: string[]): any[] | null {
      // Navigate to the parent of the given path to get siblings
      if (path.length === 0) return sectionsData;
      if (path.length === 1) return sectionsData;
      
      let current = sectionsData;
      for (let i = 0; i < path.length - 1; i++) {
        const item = current.find((c: any) => c.id === path[i]);
        if (!item || !item.children) return null;
        current = item.children;
      }
      return current;
    }
    
    function getSiblingIndex(path: string[]): number {
      if (path.length === 0) return -1;
      const siblings = findItemChildren(path);
      if (!siblings) return -1;
      const id = path[path.length - 1];
      return siblings.findIndex((s: any) => s.id === id);
    }

    function createChapter(path: string[]): HTMLElement | null {
      const pathKey = getPathKey(path);
      const template = document.querySelector(`template[data-template-id="${pathKey}"]`) as HTMLTemplateElement;
      
      if (!template) return null;
      
      const content = template.content.cloneNode(true) as DocumentFragment;
      const chapter = content.querySelector('.content-chapter') as HTMLElement;
      
      if (!chapter) return null;
      
      // Add animation class
      chapter.classList.add('chapter-entering');
      
      return chapter;
    }
    
    function addChapter(path: string[]): HTMLElement | null {
      const pathKey = getPathKey(path);
      
      // If chapter already exists, just scroll to it
      const existing = getChapterElement(path);
      if (existing) {
        scrollToElement(existing);
        return existing;
      }
      
      // Create new chapter
      const chapter = createChapter(path);
      if (!chapter) return null;
      
      // Find insertion point - after parent chapter or at the end
      const parentPath = path.slice(0, -1);
      const parentKey = getPathKey(parentPath);
      const parentChapter = state.chapters.get(parentKey);
      
      if (parentChapter && parentChapter.nextSibling) {
        // Insert after parent
        journeyContainer.insertBefore(chapter, parentChapter.nextSibling);
      } else {
        // Append at end
        journeyContainer.appendChild(chapter);
      }
      
      // Track chapter
      state.chapters.set(pathKey, chapter);
      
      // Animate in
      requestAnimationFrame(() => {
        chapter.classList.remove('chapter-entering');
        chapter.classList.add('chapter-visible');
        
        // Scroll to new chapter
        scrollToElement(chapter);
      });
      
      // Update URL
      updateURL(path);
      
      return chapter;
    }
    
    function removeChapter(path: string[]): void {
      const pathKey = getPathKey(path);
      const chapter = state.chapters.get(pathKey);
      
      if (!chapter) return;
      
      // Animate out
      chapter.classList.add('chapter-leaving');
      chapter.classList.remove('chapter-visible');
      
      // Remove after animation
      setTimeout(() => {
        chapter.remove();
        state.chapters.delete(pathKey);
      }, 400);
    }
    
    function removeChaptersAfterDepth(depth: number): void {
      // Remove all chapters deeper than the given depth
      const toRemove: string[] = [];
      
      state.chapters.forEach((chapter, pathKey) => {
        const path = pathKey.split('/');
        if (path.length > depth) {
          toRemove.push(pathKey);
        }
      });
      
      toRemove.forEach(pathKey => {
        const chapter = state.chapters.get(pathKey);
        if (chapter) {
          chapter.classList.add('chapter-leaving');
          chapter.classList.remove('chapter-visible');
          setTimeout(() => {
            chapter.remove();
            state.chapters.delete(pathKey);
          }, 400);
        }
      });
    }
    
    function removeChaptersBelow(path: string[]): void {
      // Remove all chapters that are siblings or children of siblings after this path
      const depth = path.length;
      const pathKey = getPathKey(path);
      
      const toRemove: string[] = [];
      
      state.chapters.forEach((chapter, key) => {
        const keyPath = key.split('/');
        
        // Skip if it's an ancestor or the target itself
        if (key === pathKey) return;
        if (path.slice(0, keyPath.length).join('/') === key) return;
        
        // Remove if it's at same depth or deeper and not on our path
        if (keyPath.length >= depth) {
          // Check if it shares the same ancestor
          const sharedAncestor = keyPath.slice(0, depth - 1).join('/') === path.slice(0, depth - 1).join('/');
          if (sharedAncestor && keyPath[depth - 1] !== path[depth - 1]) {
            toRemove.push(key);
          }
          // Also remove all children of non-matching branches
          else if (keyPath.length > depth) {
            const isOnPath = keyPath.slice(0, depth).join('/') === pathKey;
            if (!isOnPath) {
              toRemove.push(key);
            }
          }
        }
      });
      
      toRemove.forEach(key => removeChapter(key.split('/')));
    }
    
    // ============================================================================
    // NAVIGATION LOGIC
    // ============================================================================
    
    function navigateTo(path: string[], skipScroll = false): void {
      const previousPath = state.activePath;
      state.activePath = path;
      
      // Check if going back up (navigating to ancestor)
      const isGoingUp = path.length < previousPath.length && 
        previousPath.slice(0, path.length).join('/') === path.join('/');
      
      // Check if this is a sibling change (same depth, same parent)
      const isSiblingChange = previousPath.length === path.length && 
        previousPath.length > 0 &&
        previousPath.slice(0, -1).join('/') === path.slice(0, -1).join('/') &&
        previousPath[previousPath.length - 1] !== path[path.length - 1];
      
      // Check if navigating to sibling at a shallower level (needs to scroll up first)
      // e.g., from Previous Positions/Forecasting/Seldon to Previous Positions/Undergraduate
      const isShallowerSibling = path.length < previousPath.length && 
        previousPath.slice(0, path.length).join('/') !== path.join('/');
      
      // Handle shallower sibling: scroll up to that level, then sibling-switch
      if (isShallowerSibling) {
        // Find the divergence point (where paths start to differ)
        let divergeDepth = 0;
        for (let i = 0; i < Math.min(path.length, previousPath.length); i++) {
          if (path[i] === previousPath[i]) {
            divergeDepth = i + 1;
          } else {
            break;
          }
        }
        
        // The sibling switch happens at divergeDepth + 1 (e.g., Forecasting vs Undergraduate)
        // Scroll to the current chapter at the target's depth
        const currentAtTargetDepth = previousPath.slice(0, path.length);
        const switchChapter = getChapterElement(currentAtTargetDepth);
        
        if (switchChapter) {
          // Collect chapters deeper than target depth to remove
          const chaptersToRemove: {key: string, chapter: HTMLElement}[] = [];
          state.chapters.forEach((chapter, key) => {
            const keyPath = key.split('/');
            // Remove if deeper than target, or if at target depth but different branch
            if (keyPath.length > path.length || 
                (keyPath.length === path.length && key !== getPathKey(path))) {
              chaptersToRemove.push({ key, chapter });
            }
          });
          
          // Scroll up to the switch point
          const targetRect = switchChapter.getBoundingClientRect();
          const targetY = targetRect.top + window.scrollY - 20;
          const startY = window.scrollY;
          const distance = targetY - startY;
          const duration = Math.min(1200, Math.max(500, Math.abs(distance) * 0.5));
          
          let startTime: number | null = null;
          isNavigating = true;
          
          function easeInOutCubic(t: number): number {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }
          
          function animateAndSwitch(currentTime: number) {
            if (startTime === null) startTime = currentTime;
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easedProgress = easeInOutCubic(progress);
            
            window.scrollTo(0, startY + distance * easedProgress);
            
            if (progress < 1) {
              requestAnimationFrame(animateAndSwitch);
            } else {
              // Now do a sibling-style horizontal slide at this level
              const oldChapter = switchChapter;
              const newChapter = createChapter(path);
              
              if (newChapter) {
                // Determine slide direction based on sibling indices
                const oldIndex = getSiblingIndex(currentAtTargetDepth);
                const newIndex = getSiblingIndex(path);
                const goingRight = newIndex > oldIndex;
                
                // Create wrapper for transition
                const wrapper = document.createElement('div');
                wrapper.style.position = 'relative';
                wrapper.style.overflow = 'hidden';
                
                oldChapter.parentNode?.insertBefore(wrapper, oldChapter);
                wrapper.appendChild(oldChapter);
                oldChapter.classList.remove('chapter-visible');
                oldChapter.classList.add(goingRight ? 'slide-out-left' : 'slide-out-right');
                
                newChapter.classList.remove('chapter-entering');
                newChapter.classList.add(goingRight ? 'slide-from-right' : 'slide-from-left');
                wrapper.appendChild(newChapter);
                
                state.chapters.set(getPathKey(path), newChapter);
                
                // Animate in
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    newChapter.classList.remove('slide-from-right', 'slide-from-left');
                    newChapter.classList.add('chapter-visible');
                  });
                });
                
                // Cleanup
                setTimeout(() => {
                  wrapper.parentNode?.insertBefore(newChapter, wrapper);
                  wrapper.remove();
                  
                  // Remove old chapters (including switch chapter and its children)
                  for (const {key, chapter} of chaptersToRemove) {
                    chapter.remove();
                    state.chapters.delete(key);
                  }
                  
                  isNavigating = false;
                }, 350);
              } else {
                isNavigating = false;
              }
            }
          }
          
          requestAnimationFrame(animateAndSwitch);
          updateURL(path);
          updateBackToTopVisibility();
          return;
        }
      }
      
      // If going back up, fade out chapters as we scroll past them
      if (isGoingUp) {
        const targetChapter = getChapterElement(path);
        if (!targetChapter) {
          updateURL(path);
          updateBackToTopVisibility();
          return;
        }
        
        // Collect chapters to remove (deeper than target)
        const chaptersToRemove: {key: string, chapter: HTMLElement, top: number}[] = [];
        state.chapters.forEach((chapter, key) => {
          const keyDepth = key.split('/').length;
          if (keyDepth > path.length) {
            const rect = chapter.getBoundingClientRect();
            chaptersToRemove.push({
              key,
              chapter,
              top: rect.top + window.scrollY
            });
          }
        });
        
        // Sort by position (shallowest/highest first - we scroll up past these)
        chaptersToRemove.sort((a, b) => a.top - b.top);
        
        // Calculate scroll target - scroll UP to the target
        const targetRect = targetChapter.getBoundingClientRect();
        const targetY = targetRect.top + window.scrollY - 20;
        const startY = window.scrollY;
        const distance = targetY - startY; // Will be negative when scrolling up
        const duration = Math.min(1400, Math.max(600, Math.abs(distance) * 0.6));
        
        let startTime: number | null = null;
        const fadedChapters = new Set<string>();
        
        isNavigating = true;
        
        function easeInOutCubic(t: number): number {
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }
        
        function animateScrollUp(currentTime: number) {
          if (startTime === null) startTime = currentTime;
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easedProgress = easeInOutCubic(progress);
          
          const currentY = startY + distance * easedProgress;
          window.scrollTo(0, currentY);
          
          // Fade out chapters that are now below the viewport (we scrolled up past them)
          const viewportBottom = currentY + window.innerHeight;
          for (const {key, chapter, top} of chaptersToRemove) {
            // Fade out when the chapter's top is below viewport bottom (scrolled past it going up)
            if (top > viewportBottom - 100 && !fadedChapters.has(key)) {
              fadedChapters.add(key);
              chapter.classList.add('chapter-fading-up');
              chapter.classList.remove('chapter-visible');
            }
          }
          
          if (progress < 1) {
            requestAnimationFrame(animateScrollUp);
          } else {
            isNavigating = false;
            // Clean up faded chapters
            for (const {key, chapter} of chaptersToRemove) {
              setTimeout(() => {
                chapter.remove();
                state.chapters.delete(key);
              }, 300);
            }
          }
        }
        
        requestAnimationFrame(animateScrollUp);
        updateURL(path);
        updateBackToTopVisibility();
        return;
      }
      
      // Check if this chapter already exists
      const existingChapter = getChapterElement(path);
      
      if (existingChapter) {
        // Just scroll to it - it's already visible (unless sibling change)
        if (!isSiblingChange) {
          scrollToElement(existingChapter);
        }
        updateURL(path);
        updateBackToTopVisibility();
        return;
      }
      
      // For sibling changes, do a horizontal slide
      if (isSiblingChange) {
        const oldChapter = getChapterElement(previousPath);
        const newChapter = createChapter(path);
        
        if (oldChapter && newChapter) {
          // Determine slide direction based on sibling indices
          const oldIndex = getSiblingIndex(previousPath);
          const newIndex = getSiblingIndex(path);
          const goingRight = newIndex > oldIndex;
          
          // Create a wrapper to contain both during transition
          const wrapper = document.createElement('div');
          wrapper.style.position = 'relative';
          wrapper.style.overflow = 'hidden';
          
          // Insert wrapper where old chapter was
          oldChapter.parentNode?.insertBefore(wrapper, oldChapter);
          
          // Move old chapter into wrapper and set up for exit
          wrapper.appendChild(oldChapter);
          oldChapter.classList.remove('chapter-visible');
          oldChapter.classList.add(goingRight ? 'slide-out-left' : 'slide-out-right');
          
          // Set up new chapter and add to wrapper
          newChapter.classList.remove('chapter-entering');
          newChapter.classList.add(goingRight ? 'slide-from-right' : 'slide-from-left');
          wrapper.appendChild(newChapter);
          
          // Track new chapter
          state.chapters.set(getPathKey(path), newChapter);
          state.chapters.delete(getPathKey(previousPath));
          
          // Animate new chapter in
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              newChapter.classList.remove('slide-from-right', 'slide-from-left');
              newChapter.classList.add('chapter-visible');
            });
          });
          
          // Cleanup after animation
          setTimeout(() => {
            // Move new chapter out of wrapper
            wrapper.parentNode?.insertBefore(newChapter, wrapper);
            // Remove wrapper (which contains old chapter)
            wrapper.remove();
            
            // Also remove any children of the old sibling
            const oldPathKey = getPathKey(previousPath);
            const toRemove: string[] = [];
            state.chapters.forEach((chapter, key) => {
              if (key.startsWith(oldPathKey + '/')) {
                toRemove.push(key);
              }
            });
            toRemove.forEach(key => {
              const chapter = state.chapters.get(key);
              if (chapter) {
                chapter.remove();
                state.chapters.delete(key);
              }
            });
          }, 350);
          
          updateURL(path);
          updateBackToTopVisibility();
          return;
        }
      }
      
      // Remove chapters that would conflict with new path
      removeChaptersBelow(path);
      
      // Ensure all ancestors exist
      for (let i = 1; i <= path.length; i++) {
        const ancestorPath = path.slice(0, i);
        const ancestorKey = getPathKey(ancestorPath);
        
        if (!state.chapters.has(ancestorKey)) {
          const chapter = createChapter(ancestorPath);
          if (chapter) {
            journeyContainer.appendChild(chapter);
            state.chapters.set(ancestorKey, chapter);
            
            // Make visible without animation for ancestors
            if (i < path.length) {
              chapter.classList.remove('chapter-entering');
              chapter.classList.add('chapter-visible');
            }
          }
        }
      }
      
      // Scroll to target chapter
      const targetChapter = getChapterElement(path);
      if (targetChapter) {
        targetChapter.classList.remove('chapter-entering');
        targetChapter.classList.add('chapter-visible');
        scrollToElement(targetChapter);
      }
      
      updateURL(path);
      updateBackToTopVisibility();
    }
    
    function scrollToPath(pathKey: string): void {
      if (pathKey === 'hero') {
        smoothScrollTo(0);
        return;
      }
      
      const path = pathKey.split('/');
      const chapter = getChapterElement(path);
      
      if (chapter) {
        scrollToElement(chapter);
      }
    }
    
    // ============================================================================
    // AUTO-COLLAPSE ON SCROLL
    // ============================================================================
    
    function handleScroll(): void {
      if (isNavigating) return; // Don't collapse during programmatic scrolling
      
      if (!ticking) {
        requestAnimationFrame(() => {
          checkChapterVisibility();
          ticking = false;
        });
        ticking = true;
      }
    }
    
    function checkChapterVisibility(): void {
      const viewportTop = window.scrollY;
      const viewportHeight = window.innerHeight;
      const collapseThreshold = viewportTop - viewportHeight * 0.5; // Collapse when fully off screen
      
      // Check each chapter from deepest to shallowest
      const sortedChapters = Array.from(state.chapters.entries())
        .sort((a, b) => b[0].split('/').length - a[0].split('/').length);
      
      for (const [pathKey, chapter] of sortedChapters) {
        const rect = chapter.getBoundingClientRect();
        const chapterBottom = rect.bottom + window.scrollY;
        
        // If the chapter's bottom is above our collapse threshold
        // AND we're scrolling up (chapter is above viewport)
        if (rect.bottom < -viewportHeight * 0.3) {
          // Collapse this chapter and all its children
          const path = pathKey.split('/');
          
          // Only collapse if it's not an ancestor of current scroll position
          const currentChapterAtViewport = getCurrentVisibleChapter();
          if (currentChapterAtViewport) {
            const currentPath = currentChapterAtViewport.split('/');
            const isAncestor = currentPath.slice(0, path.length).join('/') === pathKey;
            
            if (!isAncestor) {
              removeChapter(path);
            }
          }
        }
      }
    }
    
    function getCurrentVisibleChapter(): string | null {
      const viewportCenter = window.scrollY + window.innerHeight / 3;
      
      let closestChapter: string | null = null;
      let closestDistance = Infinity;
      
      state.chapters.forEach((chapter, pathKey) => {
        const rect = chapter.getBoundingClientRect();
        const chapterTop = rect.top + window.scrollY;
        const distance = Math.abs(chapterTop - viewportCenter);
        
        if (distance < closestDistance) {
          closestDistance = distance;
          closestChapter = pathKey;
        }
      });
      
      return closestChapter;
    }
    
    // ============================================================================
    // URL & DEEP LINKING
    // ============================================================================
    
    function updateURL(path: string[]): void {
      const hash = path.length > 0 ? '#' + path.join('/') : '';
      if (window.location.hash !== hash) {
        history.pushState({ path }, '', hash || window.location.pathname);
      }
    }
    
    function loadFromURL(): void {
      const hash = window.location.hash.slice(1); // Remove #
      if (!hash) return;
      
      const path = hash.split('/').filter(Boolean);
      if (path.length > 0) {
        // Validate path exists
        let current = (window as any).__SECTIONS__;
        let valid = true;
        
        for (const id of path) {
          const found = current.find((item: any) => item.id === id);
          if (!found) {
            valid = false;
            break;
          }
          current = found.children || [];
        }
        
        if (valid) {
          // Build up the path gradually
          setTimeout(() => navigateTo(path), 100);
        }
      }
    }
    
    // ============================================================================
    // EVENT HANDLING
    // ============================================================================
    
    function updateBackToTopVisibility(): void {
      const backToTop = document.getElementById('back-to-top');
      const footer = document.getElementById('site-footer');
      const hasChapters = state.chapters.size > 0;
      if (backToTop) {
        backToTop.hidden = !hasChapters;
      }
      if (footer) {
        footer.hidden = !hasChapters;
      }
    }
    
    function handleNavClick(e: Event): void {
      const target = e.target as HTMLElement;
      
      // Navigation button click
      const navBtn = target.closest('.nav-btn') as HTMLElement;
      if (navBtn) {
        const pathStr = navBtn.dataset.path;
        if (pathStr) {
          const path = JSON.parse(pathStr);
          navigateTo(path);
        }
        return;
      }
      
      // Sibling option click (from vertical sibling stacks)
      const siblingBtn = target.closest('[data-nav-to]') as HTMLElement;
      if (siblingBtn) {
        const pathStr = siblingBtn.dataset.navTo;
        if (pathStr) {
          const path = JSON.parse(pathStr);
          navigateTo(path);
        }
        return;
      }
      
      // Breadcrumb or back-to-top click
      const scrollBtn = target.closest('[data-scroll-to]') as HTMLElement;
      if (scrollBtn) {
        const scrollTarget = scrollBtn.dataset.scrollTo;
        if (scrollTarget) {
          if (scrollTarget === 'hero') {
            // Take a calm ride to the top, then clear everything
            const keys = Array.from(state.chapters.keys());
            const clearChapters = () => {
              state.activePath = [];
              keys.forEach(key => removeChapter(key.split('/')));
              updateURL([]);
              updateBackToTopVisibility();
            };
            const gentleDuration = Math.min(1800, Math.max(900, window.scrollY * 0.9));
            smoothScrollTo(0, { duration: gentleDuration, onComplete: clearChapters });
            return;
          }
          // For breadcrumb clicks, navigate to that path (which handles scroll-up properly)
          const targetPath = scrollTarget.split('/');
          navigateTo(targetPath);
        }
        return;
      }
    }
    
    // ============================================================================
    // INITIALIZATION
    // ============================================================================
    
    function init(): void {
      // Event delegation
      document.addEventListener('click', handleNavClick);
      
      // Scroll handling for auto-collapse
      window.addEventListener('scroll', handleScroll, { passive: true });
      
      // Handle browser back/forward
      window.addEventListener('popstate', (e) => {
        if (e.state?.path) {
          navigateTo(e.state.path);
        } else {
          // Clear all chapters and scroll to top
          state.chapters.forEach((_, key) => removeChapter(key.split('/')));
          smoothScrollTo(0);
        }
      });
      
      // Load from URL on page load
      loadFromURL();

      // Wire up the contact email link without exposing the address as a substring in the source HTML
      const emailLink = document.getElementById('contact-email');
      if (emailLink instanceof HTMLAnchorElement) {
        const user = ['contact', 'schoenegger'].join('.');
        const domain = ['gmail', 'com'].join('.');
        emailLink.href = 'mailto:' + user + '@' + domain;
      }
    }
    
    document.addEventListener('DOMContentLoaded', init);
  </script>
</BaseLayout>
