---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  scholarlyArticles?: any[];
}

const {
  title = "Philipp Schoenegger — Futures Researcher, Microsoft AI",
  description = "Philipp Schoenegger — Futures Researcher at Microsoft AI. Research on AI evaluations, frontier safety, AI usage, forecasting, and behavioural science.",
  scholarlyArticles = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Philipp Schoenegger" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Philipp Schoenegger" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content="https://philippschoenegger.com/pic.jpg" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Portrait of Philipp Schoenegger" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://philippschoenegger.com/pic.jpg" />
    <meta name="twitter:image:alt" content="Portrait of Philipp Schoenegger" />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload critical resources -->
    <link rel="preload" href="/pic.jpg" as="image" />

    <!-- Fonts with optimal loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#0284c7" />

    <title>{title}</title>

    <!-- Theme Initialization Script -->
    <script is:inline>
      const theme = localStorage.getItem("theme");

      // Default to Light Mode unless explicitly set to Dark
      if (theme === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
  </head>
  <body>
    <div class="theme-toggle-container">
      <ThemeToggle />
    </div>
    <slot />

    <style>
      .theme-toggle-container {
        position: fixed;
        top: 1rem;
        right: 1.5rem;
        z-index: 100;
        mix-blend-mode: difference; /* Ensures visibility on all backgrounds */
        color: white; /* For difference mode */
      }

      @media (max-width: 768px) {
        .theme-toggle-container {
          top: 0.75rem;
          right: 0.75rem;
        }
      }
    </style>

    <!-- Structured data for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Philipp Schoenegger",
      "alternateName": [
        "Philip Schoenegger",
        "Philipp Schönegger",
        "Philip Schönegger"
      ],
      "url": "https://philippschoenegger.com",
      "image": "https://philippschoenegger.com/pic.jpg",
      "jobTitle": "Futures Researcher",
      "description": "Futures Researcher on Microsoft AI's Futures team in the Office of the CEO. Research on AI evaluations, frontier safety, forecasting, and behavioural science.",
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "ORCID",
        "value": "0000-0001-9930-487X"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "Microsoft AI",
        "url": "https://microsoft.ai/",
        "department": {
          "@type": "Organization",
          "name": "Futures team, Office of the CEO"
        }
      },
      "affiliation": [
        {
          "@type": "Organization",
          "name": "Microsoft AI",
          "url": "https://microsoft.ai/"
        }
      ],
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "University of St Andrews",
          "url": "https://www.st-andrews.ac.uk/"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "University of Graz",
          "url": "https://www.uni-graz.at/"
        }
      ],
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Researcher",
        "occupationLocation": {
          "@type": "Organization",
          "name": "Microsoft AI"
        }
      },
      "knowsAbout": [
        "Artificial Intelligence",
        "AI Evaluations",
        "AI Usage Analysis",
        "Frontier AI Safety",
        "AI Security and Privacy",
        "Large Language Models",
        "Machine Learning",
        "Behavioural Economics",
        "Decision Science",
        "Experimental Philosophy",
        "Social Psychology",
        "Forecasting",
        "Superforecasting",
        "Judgemental Forecasting"
      ],
      "award": [
        "Runner-up, 2025 Best Paper Award (ACM Transactions on Interactive Intelligent Systems)"
      ],
      "sameAs": [
        "https://x.com/SchoeneggerPhil",
        "https://www.linkedin.com/in/philipp-schoenegger-755117211/",
        "https://scholar.google.com/citations?hl=en&user=kDAq8DcAAAAJ&view_op=list_works&sortby=pubdate",
        "https://orcid.org/0000-0001-9930-487X"
      ]
    })} />

    <!-- WebSite schema for sitelinks search box -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Philipp Schoenegger",
      "url": "https://philippschoenegger.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://scholar.google.com/scholar?q=Schoenegger+{search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    {scholarlyArticles.length > 0 && scholarlyArticles.map((article: any) => (
      <script type="application/ld+json" set:html={JSON.stringify(article)} />
    ))}
  </body>
</html>
