---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Philipp Schoenegger",
  description = "Research on AI, economics, philosophy, and psychology. Microsoft AI Futures team.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Philipp Schoenegger" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Philipp Schoenegger" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content="https://philippschoenegger.com/pic.jpg" />
    <meta property="og:image:width" content="1619" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Portrait of Philipp Schoenegger" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://philippschoenegger.com/pic.jpg" />
    <meta name="twitter:image:alt" content="Portrait of Philipp Schoenegger" />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload critical resources -->
    <link rel="preload" href="/pic.jpg" as="image" />

    <!-- Fonts with optimal loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#0284c7" />

    <title>{title}</title>

    <!-- Theme Initialization Script -->
    <script is:inline>
      const theme = localStorage.getItem("theme");

      // Default to Light Mode unless explicitly set to Dark
      if (theme === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
  </head>
  <body>
    <div class="theme-toggle-container">
      <ThemeToggle />
    </div>
    <slot />

    <style>
      .theme-toggle-container {
        position: fixed;
        top: 1rem;
        right: 1.5rem;
        z-index: 100;
        mix-blend-mode: difference; /* Ensures visibility on all backgrounds */
        color: white; /* For difference mode */
      }

      @media (max-width: 768px) {
        .theme-toggle-container {
          top: 0.75rem;
          right: 0.75rem;
        }
      }
    </style>

    <!-- Structured data for SEO -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Philipp Schoenegger",
        "alternateName": [
          "Philip Schoenegger",
          "Philipp Schönegger",
          "Philip Schönegger"
        ],
        "url": "https://philippschoenegger.com",
        "jobTitle": "Futures Researcher",
        "description": "Futures Researcher on AI, economics, philosophy, and psychology at Microsoft AI Futures team",
        "worksFor": {
          "@type": "Organization",
          "name": "Microsoft",
          "department": "AI Futures"
        },
        "knowsAbout": [
          "Artificial Intelligence",
          "Machine Learning",
          "Economics",
          "Philosophy",
          "Psychology",
          "Behavioral Science",
          "AI Safety",
          "Forecasting"
        ],
        "sameAs": [
          "https://x.com/SchoeneggerPhil",
          "https://www.linkedin.com/in/philipp-schoenegger-755117211/",
          "https://scholar.google.com/citations?hl=en&user=kDAq8DcAAAAJ&view_op=list_works&sortby=pubdate"
        ]
      }
    </script>
  </body>
</html>
